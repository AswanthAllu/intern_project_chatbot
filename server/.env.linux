# =============================================================================
# AI CHATBOT APPLICATION - LINUX DEPLOYMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values according to your environment

# Server Configuration
PORT=5005
NODE_ENV=production
HOST=0.0.0.0

# Database Configuration
# Option 1: Local MongoDB (install MongoDB on your Linux server)
# MONGO_URI=mongodb://localhost:27017/chatbotGeminiDB4

# Option 2: MongoDB Atlas (cloud database - recommended)
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chatbotGeminiDB4?retryWrites=true&w=majority

# API Keys (REQUIRED - Replace with your own keys)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Get from: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_api_key_here

# Security (Generate a secure random string)
JWT_SECRET=your_secure_jwt_secret_here

# Service URLs
OLLAMA_URL=http://localhost:11434
MCP_HTTP_BASE=http://127.0.0.1:8765
NODE_SERVER_API_BASE=http://0.0.0.0:5005

# Client Configuration
REACT_APP_BACKEND_PORT=5005
REACT_APP_API_BASE_URL=http://your-server-ip:5005/api

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# ML Training Configuration
ML_TRAINING_DIR=./ml_training
PYTHON_PATH=/usr/bin/python3

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# SSL Configuration (for HTTPS deployment)
# SSL_CERT_PATH=/etc/ssl/certs/your-cert.pem
# SSL_KEY_PATH=/etc/ssl/private/your-key.pem
# ENABLE_HTTPS=false

# Process Management
PM2_INSTANCES=max
PM2_MAX_MEMORY_RESTART=1G
