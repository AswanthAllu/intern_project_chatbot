# =============================================================================
# AI CHATBOT APPLICATION - DEVELOPMENT CONFIGURATION
# =============================================================================
# DO NOT COMMIT REAL API KEYS TO GIT
# Copy .env.linux to .env and add your real API keys for deployment

# Server Configuration
PORT=5005
NODE_ENV=development

# Database Configuration
# For local MongoDB (uncomment if using local instance)
# MONGO_URI=mongodb://localhost:27017/chatbotGeminiDB4

# For MongoDB Atlas (cloud database - recommended for production)
MONGO_URI=your_mongodb_connection_string_here

# API Keys (REPLACE WITH YOUR REAL KEYS - DO NOT COMMIT)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# Security
JWT_SECRET=your_secure_jwt_secret_here

# Service URLs (Linux-compatible)
OLLAMA_URL=http://localhost:11434
MCP_HTTP_BASE=http://127.0.0.1:8765
NODE_SERVER_API_BASE=http://0.0.0.0:5005

# Client Configuration
REACT_APP_BACKEND_PORT=5005
REACT_APP_API_BASE_URL=http://localhost:5005/api

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# ML Training Configuration
ML_TRAINING_DIR=./ml_training
PYTHON_PATH=/usr/bin/python3

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log